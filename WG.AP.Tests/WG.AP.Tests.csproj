<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- Only TestManifestReader needs Excel now - see the note there on why the reader survived. -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Gives the conditional Skip.If that xunit 2.x lacks, so a test that could not run reports as
         Skipped rather than Passed. Becomes removable once the tracked xunit -> xunit.v3 migration
         lands (docs/GraphMailboxProcessor.md), since v3 has Assert.Skip built in. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WG.AP.Core\WG.AP.Core.csproj" />
    <ProjectReference Include="..\WG.AP.DataAccess\WG.AP.DataAccess.csproj" />
    <ProjectReference Include="..\WG.AP.Email\WG.AP.Email.csproj" />
    <ProjectReference Include="..\WG.AP.Integrations.Pace\WG.AP.Integrations.Pace.csproj" />
    <ProjectReference Include="..\WG.AP.Invoice\WG.AP.Invoice.csproj" />
    <ProjectReference Include="..\WG.AP.Processing\WG.AP.Processor.csproj" />
    <ProjectReference Include="..\WG.AP.Reporting\WG.AP.Reporting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>